<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Calculator" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_on_surface</item>
    </style>

    <!-- Button base -->
    <style name="CalcBtn" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">50dp</item>
    </style>

    <style name="CalcBtn.Number" parent="CalcBtn">
        <item name="backgroundTint">@color/btn_number_bg</item>
        <item name="android:textColor">@color/btn_number_text</item>
    </style>

    <style name="CalcBtn.Operator" parent="CalcBtn">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcBtn.Function" parent="CalcBtn">
        <item name="backgroundTint">@color/btn_function_bg</item>
        <item name="android:textColor">@color/btn_function_text</item>
    </style>

    <style name="CalcBtn.Equal" parent="CalcBtn">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcBtn.Sci" parent="CalcBtn">
        <item name="backgroundTint">@color/btn_sci_bg</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
